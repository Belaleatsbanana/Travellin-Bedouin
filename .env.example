# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit it.

# ── Backend (Groq) ────────────────────────────────────────
# Get your free key at https://console.groq.com
GROQ_API_KEY=

# ── Frontend build args (baked into the Next.js bundle) ───
# Override the backend URL when deploying to a real server.
# Leave blank to use the default (http://localhost:8000).
NEXT_PUBLIC_API_BASE_URL=
