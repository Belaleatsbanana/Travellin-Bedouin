# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: LLM model override ──────────────────────────────────────────────
# Default: llama-3.3-70b-versatile
# Other options: llama3-70b-8192  |  mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional: Amadeus Tours & Activities API ───────────────────────────────────
# Register at https://developers.amadeus.com/register (free test credentials)
# Without these, the agent falls back to LLM knowledge + web search
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# ── Optional: Web search (pick one or leave blank for DuckDuckGo fallback) ────
# SerpAPI  → https://serpapi.com  (100 free searches/month)
SERP_API_KEY=
# Serper.dev → https://serper.dev  (2500 free searches)
SERPER_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_SECONDS=86400
